__pycache__/
*.py[cod]
.ipynb_checkpoints/
.inspection/

# Datasets are acquired reproducibly and are never committed.
data/raw/
data/processed/

# Runtime artifacts are generated per experiment.
experiments/**/best_model.pt
!experiments/**/full/best_model.pt
experiments/**/last_model.pt
experiments/**/cache/
experiments/**/console.log
experiments/**/runner.pid
experiments/**/progress.json
experiments/**/progress.json.tmp

# Full-stack platform local dependencies, credentials, and serving artifacts.
backend/.venv/
backend/.env
backend/.env.*
!backend/.env.example
backend/model-assets/
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/tsconfig.tsbuildinfo
.platform-runtime/
frontend/test-results/
frontend/playwright-report/
