MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=hitskt_learning
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Optional. Both paths required. Install requirements-model.txt before enabling.
# HITSKT_CHECKPOINT=../experiments/hitskt/ednet_kt1/full/best_model.pt
# HITSKT_MANIFEST=./model-assets/manifest.json
# Local-only sample accounts are disabled by default.
DEMO_ENABLED=false

# Optional Junyi pilot. Use existing Lumen account IDs from the local account store.
# JUNYI_STUDENT_ACCOUNT_ID=
# JUNYI_OPERATOR_ACCOUNT_ID=
# JUNYI_HISTORY_SHA256=
# JUNYI_CHECKPOINT=
# JUNYI_HISTORY_FILE=
# JUNYI_BANK_FILE=
# JUNYI_RANKING_FILE=
# Optional reviewed study-topic forest. Install requirements-study-forest.txt in Python 3.12.
# JUNYI_STUDY_FOREST_FILE=
# JUNYI_STAGE=junior
# JUNYI_ALLOW_REUSE=false
# JUNYI_QUOTAS=[8,6,4,2]
# Optional provider. Set these only in the backend environment.
# GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# Optional password recovery (email credentials belong in a local .env).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
